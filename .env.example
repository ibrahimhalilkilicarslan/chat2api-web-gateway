# Runtime
NODE_ENV=production
CHAT2API_HOST=0.0.0.0
PORT=8080
CHAT2API_DATABASE_PATH=/data/chat2api.sqlite
CHAT2API_LOG_LEVEL=info
# Number of trusted reverse-proxy hops. Use false for direct local access.
CHAT2API_TRUST_PROXY=1
CHAT2API_SECURE_COOKIES=true

# Required secrets. Generate unique values; never commit real values.
# openssl rand -base64 32
CHAT2API_MASTER_KEY=
# openssl rand -base64 48
CHAT2API_BOOTSTRAP_API_KEY=
CHAT2API_ADMIN_TOKEN=
CHAT2API_SESSION_SECRET=

# Browser/admin access. Comma-separated exact origins.
CHAT2API_ADMIN_ORIGINS=https://chat2api.example.com

# Request and routing limits
CHAT2API_MAX_BODY_BYTES=2097152
CHAT2API_GLOBAL_CONCURRENCY=20
CHAT2API_ACCOUNT_CONCURRENCY=2
CHAT2API_RATE_LIMIT_RPM=60
CHAT2API_DAILY_QUOTA=1000
CHAT2API_REQUEST_TIMEOUT_MS=120000
CHAT2API_FIRST_BYTE_TIMEOUT_MS=30000
