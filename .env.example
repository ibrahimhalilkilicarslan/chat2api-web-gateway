# Runtime
NODE_ENV=production
CHAT2API_HOST=0.0.0.0
PORT=8080
CHAT2API_DATABASE_PATH=/data/chat2api.sqlite
CHAT2API_LOG_LEVEL=info
# Number of trusted reverse-proxy hops. Use false for direct local access.
CHAT2API_TRUST_PROXY=1
CHAT2API_SECURE_COOKIES=true

# Required secrets. Generate unique values; never commit real values.
# openssl rand -base64 32
CHAT2API_MASTER_KEY=
# openssl rand -base64 48
CHAT2API_BOOTSTRAP_API_KEY=
CHAT2API_ADMIN_TOKEN=
CHAT2API_SESSION_SECRET=

# Browser/admin access. Comma-separated exact origins and hostnames.
CHAT2API_ADMIN_ORIGINS=https://chat2api.example.com
CHAT2API_ADMIN_HOSTS=chat2api.example.com

# Request and routing limits
CHAT2API_MAX_BODY_BYTES=20971520
CHAT2API_GLOBAL_CONCURRENCY=20
CHAT2API_ACCOUNT_CONCURRENCY=1
CHAT2API_BACKGROUND_ACCOUNT_RESERVE=1
CHAT2API_BACKGROUND_USAGE_RESERVE=10
CHAT2API_ACCOUNT_USAGE_WINDOW_MS=900000
CHAT2API_QUEUE_MAX_DEPTH=100
CHAT2API_QUEUE_TIMEOUT_MS=60000
CHAT2API_DEEPSEEK_SESSION_TTL_MS=300000
CHAT2API_RATE_LIMIT_RPM=60
CHAT2API_DAILY_QUOTA=1000
CHAT2API_REQUEST_TIMEOUT_MS=120000
CHAT2API_FIRST_BYTE_TIMEOUT_MS=30000
CHAT2API_STREAM_IDLE_TIMEOUT_MS=90000
# Set to 0 only in isolated tests. Production default: 15 minutes.
CHAT2API_ACCOUNT_HEALTH_INTERVAL_MS=3600000
# Optional http(s) webhook. When set, the gateway POSTs a JSON alert when a
# DeepSeek account transitions to unhealthy (token expired/suspended) or recovers.
# Leave unset to rely on structured logs only.
# CHAT2API_ALERT_WEBHOOK_URL=https://hooks.example.com/chat2api-alerts
