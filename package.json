{
  "name": "chat2api-web-gateway",
  "version": "2.0.0",
  "private": true,
  "description": "Hardened, web-only OpenAI-compatible gateway for isolated provider accounts.",
  "type": "module",
  "license": "GPL-3.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/bootstrap.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "pnpm clean && pnpm build:web && pnpm build:server && pnpm copy:runtime-assets",
    "build:web": "vite build",
    "build:server": "tsup",
    "copy:runtime-assets": "node scripts/copy-runtime-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "start": "node dist/server/bootstrap.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:check": "node scripts/security-guard.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "backup:sqlite": "node scripts/backup-sqlite.mjs",
    "ops:check": "bash -n scripts/ops/*.sh",
    "smoke:container": "node scripts/container-smoke.mjs",
    "smoke:remote": "node scripts/remote-smoke.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm ops:check && pnpm security:check && pnpm audit:prod"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/static": "10.1.2",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "axios": "1.18.1",
    "better-sqlite3": "13.0.2",
    "dotenv": "17.4.2",
    "eventsource-parser": "3.1.0",
    "fastify": "5.10.0",
    "form-data": "4.0.6",
    "lucide-react": "1.27.0",
    "mime-types": "3.0.2",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zstd-codec": "0.1.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/mime-types": "3.0.1",
    "@types/node": "22.15.30",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "eslint": "10.8.0",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
