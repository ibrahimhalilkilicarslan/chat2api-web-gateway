{
  "name": "chat2api-web-gateway",
  "version": "2.2.1",
  "private": true,
  "description": "Hardened, web-only OpenAI-compatible gateway for isolated DeepSeek web accounts.",
  "type": "module",
  "license": "GPL-3.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "admin:token": "node scripts/show-admin-token.mjs",
    "dev": "concurrently -k -n server,web -c cyan,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/bootstrap.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "pnpm clean && pnpm build:web && pnpm build:server && pnpm copy:runtime-assets",
    "build:web": "vite build && node scripts/package-deepseek-connector.mjs",
    "build:server": "node scripts/build-server.mjs",
    "copy:runtime-assets": "node scripts/copy-runtime-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "start": "node dist/server/bootstrap.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:check": "node scripts/security-guard.mjs",
    "i18n:check": "node scripts/i18n-guard.mjs",
    "setup:smoke": "node scripts/setup-smoke.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "backup:sqlite": "node scripts/backup-sqlite.mjs",
    "backup:verify": "node scripts/verify-sqlite-backup.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "licenses:check": "node scripts/license-audit.mjs",
    "history:scan": "bash scripts/history-secret-scan.sh",
    "ops:check": "bash -n scripts/install.sh scripts/show-admin-token.sh scripts/history-secret-scan.sh scripts/ops/*.sh",
    "smoke:container": "node scripts/container-smoke.mjs",
    "smoke:remote": "node scripts/remote-smoke.mjs",
    "smoke:compat": "node scripts/compatibility-smoke.mjs",
    "smoke:load": "node scripts/load-smoke.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm i18n:check && pnpm build && pnpm ops:check && pnpm setup:smoke && pnpm security:check && pnpm licenses:check && pnpm audit:prod"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/static": "10.1.2",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "axios": "1.18.1",
    "better-sqlite3": "13.0.2",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.30",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
