# Copy to ~/.config/chat2api-web-gateway/operations.env with mode 0600.
# Keep real webhook URLs and rclone configuration outside the repository.

# Optional HTTPS endpoint receiving coarse service/event/status/timestamp JSON.
CHAT2API_ALERT_WEBHOOK_URL=

# Optional rclone destination. Credentials belong in the private rclone config.
# Example: encrypted-remote:chat2api/backups
CHAT2API_OFFSITE_RCLONE_REMOTE=

# Optional explicit rclone config path.
RCLONE_CONFIG=
