{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "rootDir": ".",
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src/core/**/*.ts",
    "src/server/**/*.ts",
    "src/main/providers/**/*.ts",
    "src/main/lib/**/*.ts",
    "src/main/proxy/**/*.ts",
    "src/main/store/store.ts",
    "src/main/store/types.ts",
    "src/types/**/*.d.ts",
    "vitest.config.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
